{
  "components": {
    "schemas": {
      "ErrorBody": {
        "additionalProperties": {},
        "description": "Error reported by the endpoint itself.",
        "properties": {
          "error": {
            "description": "Machine-readable error keyword.",
            "type": "string"
          },
          "message": {
            "description": "Human-readable description of what went wrong.",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": {},
        "description": "Error reported by the API framework.",
        "properties": {
          "message": {
            "description": "Human-readable description of what went wrong.",
            "type": "string"
          },
          "request-id": {
            "description": "Identifier of the failed request.",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code of the error.",
            "format": "int64",
            "type": "integer"
          },
          "trace-id": {
            "description": "Trace identifier to quote when contacting support.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ],
        "type": "object"
      },
      "Event": {
        "additionalProperties": {},
        "description": "A JSON event object, shaped by the event type configured for the stream.",
        "type": "object"
      },
      "KeychainLookup": {
        "additionalProperties": false,
        "description": "Identity keys to look a profile up by.",
        "properties": {
          "enrich": {
            "description": "Join lookup-table values into the returned attributes.",
            "type": "boolean"
          },
          "keys": {
            "$ref": "#/components/schemas/KeychainLookupKeys"
          }
        },
        "required": [
          "keys"
        ],
        "type": "object"
      },
      "KeychainLookupKeys": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Keychain keys mapped to the values to match.",
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "description": "A real-time customer profile.",
        "properties": {
          "attributes": {
            "$ref": "#/components/schemas/ProfileAttributes"
          },
          "collection_id": {
            "description": "Identifier of the profile collection.",
            "example": "apc-2RP8xZMbG",
            "type": "string"
          },
          "created_at": {
            "description": "When the profile was first built.",
            "format": "date-time",
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/ProfileLinks"
          },
          "profile_id": {
            "description": "The profile's Amperity ID.",
            "example": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
            "type": "string"
          },
          "ticked_at": {
            "description": "When the profile was last evaluated.",
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "description": "When the profile last changed.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "collection_id",
          "profile_id"
        ],
        "type": "object"
      },
      "ProfileAttributes": {
        "additionalProperties": {},
        "description": "Attribute values held for this profile.",
        "type": "object"
      },
      "ProfileLinks": {
        "additionalProperties": {},
        "description": "Keychain links this profile is reachable by.",
        "type": "object"
      },
      "ProfileSegment": {
        "additionalProperties": false,
        "description": "A real-time segment a profile belongs to.",
        "properties": {
          "segment_id": {
            "description": "Identifier of the real-time segment.",
            "example": "rts-3AV2oor45",
            "type": "string"
          },
          "segment_name": {
            "description": "Name of the real-time segment.",
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "segment_name"
        ],
        "type": "object"
      },
      "ProfileSegmentsEnvelope": {
        "additionalProperties": false,
        "description": "Paginated list of a profile's real-time segment memberships.",
        "properties": {
          "data": {
            "description": "Segments on this page.",
            "items": {
              "$ref": "#/components/schemas/ProfileSegment"
            },
            "type": "array"
          },
          "next_token": {
            "description": "Cursor from a previous response, to fetch the following page.",
            "type": "string"
          },
          "total": {
            "description": "Total segments the profile belongs to.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SegmentMember": {
        "additionalProperties": false,
        "description": "A profile that is a member of the segment.",
        "properties": {
          "profile_id": {
            "description": "The profile's Amperity ID.",
            "example": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
            "type": "string"
          }
        },
        "required": [
          "profile_id"
        ],
        "type": "object"
      },
      "SegmentMembersEnvelope": {
        "additionalProperties": false,
        "description": "Paginated list of a segment's member profiles.",
        "properties": {
          "data": {
            "description": "Profiles on this page.",
            "items": {
              "$ref": "#/components/schemas/SegmentMember"
            },
            "type": "array"
          },
          "next_token": {
            "description": "Cursor from a previous response, to fetch the following page.",
            "type": "string"
          },
          "total": {
            "description": "Total members of the segment.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Authenticate with an Amperity access token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@amperity.com",
      "name": "Amperity Support",
      "url": "https://docs.amperity.com/"
    },
    "description": "Send events to a stream, read real-time customer profiles, and read real-time segment membership. Name the version to serve a request at in the `api-version` header; a request without it is served the latest version.",
    "title": "Amperity Real-Time API",
    "version": "2026-09-03",
    "x-logo": {
      "altText": "Amperity Real-Time API Docs",
      "backgroundColor": "#000",
      "url": "_static/logo-api.png"
    }
  },
  "openapi": "3.0.3",
  "paths": {
    "/events/{stream-id}": {
      "post": {
        "description": "Publishes a JSON event to the stream for real-time profile processing. The body must be a JSON object of at most 64 KiB and a Content-Length header is required. A 202 means the event was accepted for processing, not that it matched a profile.",
        "externalDocs": {
          "url": "https://docs.amperity.com/api/endpoint_post_profile_store_events.html"
        },
        "parameters": [
          {
            "description": "Identifier of the event stream.",
            "in": "path",
            "name": "stream-id",
            "required": true,
            "schema": {
              "example": "esm-23ZvjfSSJ",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          },
          "description": "A JSON event object, shaped by the event type configured for the stream.",
          "required": true
        },
        "responses": {
          "202": {
            "description": "Event accepted for processing."
          },
          "204": {
            "description": "The stream is configured to drop events; the event was discarded."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The body was not a JSON object."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No access token was supplied, or it is not valid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The token is valid but lacks the permission this endpoint requires."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No such stream for this tenant."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The method is not allowed on this path."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The stream is not accepting events."
          },
          "411": {
            "description": "A Content-Length header is required."
          },
          "413": {
            "description": "The body exceeds 64 KiB."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The event bus is unavailable; retry."
          }
        },
        "summary": "Event stream endpoint",
        "tags": [
          "Events"
        ]
      }
    },
    "/lookup/{collection-id}/keychain": {
      "get": {
        "description": "Finds a profile by one or more identity keys passed as query parameters. Every query parameter is treated as a keychain key, so the enrich flag is named `_enrich` to keep it distinct. Keys are searched in the collection's configured priority order, then any unconfigured keys supplied; the first profile matched is returned. Prefer the POST form to keep identifiers out of URLs and access logs.",
        "externalDocs": {
          "url": "https://docs.amperity.com/api/endpoint_get_profile_store_lookup.html"
        },
        "parameters": [
          {
            "description": "Identifier of the profile collection.",
            "in": "path",
            "name": "collection-id",
            "required": true,
            "schema": {
              "example": "apc-2RP8xZMbG",
              "type": "string"
            }
          },
          {
            "description": "Join lookup-table values into the returned attributes.",
            "in": "query",
            "name": "_enrich",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "The first profile matched by the supplied keys.",
            "headers": {
              "Location": {
                "description": "Canonical URL of the matched profile.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No keychain keys were supplied."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No access token was supplied, or it is not valid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The token is valid but lacks the permission this endpoint requires."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No profile in the collection matched the supplied keys."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The method is not allowed on this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Profile lookup API",
        "tags": [
          "Profiles"
        ]
      },
      "post": {
        "description": "Identical to the GET form, with the identity keys carried in the request body so they do not appear in a URL.",
        "externalDocs": {
          "url": "https://docs.amperity.com/api/endpoint_post_profile_store_lookup.html"
        },
        "parameters": [
          {
            "description": "Identifier of the profile collection.",
            "in": "path",
            "name": "collection-id",
            "required": true,
            "schema": {
              "example": "apc-2RP8xZMbG",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeychainLookup"
              }
            }
          },
          "description": "Identity keys to look a profile up by.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "The first profile matched by the supplied keys.",
            "headers": {
              "Location": {
                "description": "Canonical URL of the matched profile.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No keychain keys were supplied."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No access token was supplied, or it is not valid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The token is valid but lacks the permission this endpoint requires."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No profile in the collection matched the supplied keys."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The method is not allowed on this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Profile lookup API",
        "tags": [
          "Profiles"
        ]
      }
    },
    "/profiles/{collection-id}/{profile-id}": {
