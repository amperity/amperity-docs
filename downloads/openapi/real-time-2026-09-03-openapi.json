        "parameters": [
          {
            "description": "Identifier of the profile collection.",
            "in": "path",
            "name": "collection-id",
            "required": true,
            "schema": {
              "example": "apc-2RP8xZMbG",
              "type": "string"
            }
          },
          {
            "description": "The profile's Amperity ID.",
            "in": "path",
            "name": "profile-id",
            "required": true,
            "schema": {
              "example": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
              "type": "string"
            }
          },
          {
            "description": "Join lookup-table values into the returned attributes.",
            "in": "query",
            "name": "enrich",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "The requested profile."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
