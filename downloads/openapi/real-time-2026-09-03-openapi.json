                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No profile in the collection with that id."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The method is not allowed on this path."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Profile API",
        "tags": [
          "Profiles"
        ]
      }
    },
    "/profiles/{collection-id}/{profile-id}/segments": {
      "get": {
        "description": "Returns a paginated listing of this profile's real-time segment memberships, newest page first. Use `next_token` from a response to fetch the following page.",
        "externalDocs": {
          "url": "https://docs.amperity.com/api/endpoint_get_profile_segments.html"
        },
        "parameters": [
          {
            "description": "Identifier of the profile collection.",
            "in": "path",
            "name": "collection-id",
            "required": true,
            "schema": {
              "example": "apc-2RP8xZMbG",
              "type": "string"
            }
          },
          {
            "description": "The profile's Amperity ID.",
            "in": "path",
            "name": "profile-id",
            "required": true,
            "schema": {
              "example": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
              "type": "string"
            }
          },
          {
            "description": "Maximum number of results to return in one page.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Cursor from a previous response, to fetch the following page.",
            "in": "query",
            "name": "next_token",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSegmentsEnvelope"
                }
              }
            },
            "description": "Segment memberships for the profile."
